import { VerticalBox, HorizontalBox, Button, LineEdit, Palette } from "std-widgets.slint";

// Rendered inside MainWindow rather than as a separate OS window, which window
// managers can stack below the main window or mis-size (#193). Slint rebuilds a
// popup's contents on every show, so a typed passphrase never survives a close.
export component PasswordPrompt inherits PopupWindow {
    // Slint resizes a popup to its preferred size, so this is what keeps the
    // backdrop covering the window when it is resized.
    in property <length> host-width;
    in property <length> host-height;
    in property <string> prompt-title;
    in property <string> prompt-message;
    // Non-empty when re-prompting after an incorrect passphrase.
    in property <string> error-text;
    // Toggled by the Show/Hide button to reveal the typed passphrase.
    property <bool> password-visible: false;

    callback submitted(string);
    callback cancelled();

    x: 0px;
    y: 0px;
    preferred-width: root.host-width;
    preferred-height: root.host-height;
    close-policy: PopupClosePolicy.no-auto-close;

    init => {
        input.focus();
    }

    Rectangle {
        background: #00000080;

        panel := Rectangle {
            width: min(450px, root.width - 32px);
            height: content.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 8px;

            content := VerticalBox {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: root.prompt-title;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Text { text: root.prompt-message; wrap: word-wrap; }

                if root.error-text != "": Text {
                    text: root.error-text;
                    color: #d32f2f;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    input := LineEdit {
                        horizontal-stretch: 1;
                        input-type: root.password-visible ? InputType.text : InputType.password;
                        placeholder-text: "Passphrase";
                        accepted => { root.submitted(self.text); }
                    }
                    Button {
                        text: root.password-visible ? "Hide" : "Show";
                        clicked => { root.password-visible = !root.password-visible; }
                    }
                }

                HorizontalBox {
                    alignment: end;
                    padding: 0px;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancelled(); } }
                    Button { text: "OK"; clicked => { root.submitted(input.text); } }
                }
            }
        }
    }
}
